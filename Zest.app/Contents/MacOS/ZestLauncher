#!/bin/bash
DIR="$(cd "$(dirname "$0")/../Resources" && pwd)"
cd "$DIR"
# Find python3
PY=$(which python3 2>/dev/null || which python3.13 2>/dev/null || which python3.12 2>/dev/null)
if [ -z "$PY" ]; then
    osascript -e 'display dialog "Python 3 not found. Please install Python 3 from python.org" with title "Zest Pet" buttons {"OK"} default button "OK" with icon caution'
    exit 1
fi
"$PY" -u "$DIR/zest_pet.py" &
